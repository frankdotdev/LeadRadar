# ==============================================================================
# 1. SENDER IDENTITY & SERVICES (Used for AI Qualification & Tailored Writeups)
# ==============================================================================
# Configure your name, portfolio, company, and services offered.
# These can also be edited live at any time from the Web Dashboard (Role & Settings).
SENDER_NAME=Frank Oge
SENDER_PORTFOLIO=https://frankoge.com
SENDER_COMPANY=Hackverse Technologies
SENDER_COMPANY_URL=https://hackversetechnologies.vercel.app

MY_SERVICES=Full-stack web development, mobile apps, AI automation, custom bots, UI/UX design, copywriting, Google Ads, technical consulting
MY_PITCH=I build high-converting web & mobile apps, AI automations, and digital growth systems at Hackverse Technologies.

# ==============================================================================
# 2. AI CLASSIFIER, TRANSLATOR & WRITEUP ENGINE (Optional — Free Tiers Work)
# ==============================================================================
# Supports Google Gemini OR Groq (or both for automatic failover).
# Without either key, LeadRadar uses its built-in heuristic engine + free auto-translation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_CONCURRENCY=6

# ==============================================================================
# 3. EXTENDED DISCOVERY: SERPER (GOOGLE X-RAY) & APIFY (Optional — Free Tiers)
# ==============================================================================
# Serper.dev (2,500 free searches at serper.dev): X-Ray searches X/Twitter, LinkedIn Posts,
# Facebook, Threads, Notion briefs, and Google Forms for buyer requests.
SERPER_API_KEY=
SERPER_INTERVAL=600
SERPER_TBS=qdr:d

# Apify (Free monthly credits at apify.com): Run LinkedIn, Facebook, X, or Ad scrapers.
APIFY_TOKEN=
APIFY_ACTORS=[{"name":"linkedin","actor":"lofomachines/linkedin-post-search-scraper","input":{"keywords":"{keywords}","maxResults":50},"interval":1800},{"name":"facebook","actor":"apify/facebook-posts-scraper","input":{"startUrls":[{"url":"https://www.facebook.com/SOME_PUBLIC_PAGE"}],"resultsLimit":30},"interval":3600,"need_intent":true},{"name":"x-apify","actor":"PUT_X_SEARCH_ACTOR_HERE","input":{"searchTerms":"{keywords}","maxItems":50},"interval":900}]

# ==============================================================================
# 4. CONTACT ENRICHMENT & AUTOMATIC EMAIL OUTREACH (Optional)
# ==============================================================================
# Hunter.io (25 free searches/month at hunter.io): Finds verified emails when a post links a domain.
# Note: Direct emails, phone/WhatsApp numbers, and @handles in posts are extracted automatically for free.
HUNTER_API_KEY=

# Automatic Email Sending (Gmail / Google Workspace App Password or any SMTP).
# When an email is found on a lead, LeadRadar immediately sends the tailored writeup.
# Leave blank to use the 1-click "Mail App" (mailto:) or "Copy & Open DM" buttons on the dashboard.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
AUTO_SEND_EMAIL=true
AUTO_EMAIL_MIN_SCORE=65
DRY_RUN=false

# ==============================================================================
# 5. TELEGRAM REAL-TIME ALERTS (Optional — 2-Minute Setup via @BotFather)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SCORE=70

# ==============================================================================
# 6. BUILT-IN FREE SOURCES TUNING (Pre-populated with high-signal communities)
# ==============================================================================
# Reddit subreddits across freelance hiring, software dev, AI, startups, copywriting, ads, design & regional hubs:
REDDIT_SUBS=forhire,HireAWriter,DesignJobs,jobbit,slavelabour,DoneDirtCheap,hiring,startups,Entrepreneur,smallbusiness,SideProject,SaaS,webdev,reactjs,nextjs,node,Python,shopify,ecommerce,wordpress,Automate,AI_Agents,LocalLLaMA,marketing,PPC,SEO,copywriting,VideoEditing,freelance,nigeria,lagos

# Mastodon hashtags & high-signal tech/indie/founder instances:
MASTODON_TAGS=hiring,forhire,freelance,getfedihired,fedihired,jobs,remotejobs,techjobs,webdev,needadeveloper,needadesigner,copywriting,marketing,startup,indiedev
MASTODON_INSTANCES=mastodon.social,fosstodon.org,hachyderm.io,indieweb.social,mas.to,techhub.social,infosec.exchange

# Bluesky: Leave blank to use Bluesky's free public API (public.api.bsky.app) automatically,
# or add your personal handle (e.g. yourname.bsky.social) and App Password if desired:
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Lemmy instances with active tech, freelance, and startup communities:
LEMMY_INSTANCES=lemmy.world,programming.dev,lemmy.ml,sh.itjust.works,lemmy.ca,feddit.org

# Nairaland boards (covering jobs, business, webmasters, programming, techmarket, graphics, career & adverts):
NAIRALAND_BOARDS=jobs,business,webmasters,programming,techmarket,career,graphics,computers,investment,adverts
NAIRALAND_INCLUDE_JOBS=true

# Public Telegram channels (scraped via web preview https://t.me/s/<channel>, no Telegram login needed):
TG_CHANNELS=indiehackers,startups,webdev,python_jobs,react_jobs,designjobs,copywritingjobs
TG_JOB_CHANNELS=remotework,remoteok,itfreelance,remote_tech_jobs,RemoteIT,frontend_jobs,backend_jobs,fullstack_jobs,javascript_jobs,devops_jobs,ai_jobs,blockchain_jobs,CryptoJobWork,freelance_eth,weworkremotely

# Active Remote Job & Freelance Marketplace RSS/XML Feeds (Software, Design, Copywriting, Marketing, Support):
RSS_FEEDS=https://weworkremotely.com/remote-jobs.rss,https://weworkremotely.com/categories/remote-programming-jobs.rss,https://weworkremotely.com/categories/remote-design-jobs.rss,https://weworkremotely.com/categories/remote-sales-and-marketing-jobs.rss,https://weworkremotely.com/categories/remote-customer-support-jobs.rss,https://remotive.com/remote-jobs/feed,https://himalayas.app/jobs/rss,https://jobicy.com/?feed=job_feed,https://nodesk.co/remote-jobs/index.xml,https://remoteok.com/remote-jobs.rss,https://problogger.com/jobs/feed/

# Optional Official X API v2 Bearer Token:
X_BEARER_TOKEN=

# Pipeline Tuning
MAX_AGE_HOURS=48
MIN_STORE_SCORE=35
