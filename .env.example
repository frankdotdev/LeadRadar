# --- Telegram alerts: create a bot with @BotFather, paste token, then send /start to your bot once ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# --- Optional LLM (Groq, free tier works). Without it the heuristic scorer is used ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_CONCURRENCY=6
# --- About you (used by the classifier and reply drafts) ---
MY_SERVICES=web development, mobile apps, AI bots, e-commerce, UI/UX
MY_PITCH=I run Hackverse Software Solutions and build web, mobile and AI products.
# --- Sources (comma separated). Hacker News, Reddit, Bluesky, Mastodon run by default ---
# TG_CHANNELS: channels where people post requests in sentences (checked for 'looking for a...' phrasing)
TG_CHANNELS=
# TG_JOB_CHANNELS: job-board style channels where every post is a vacancy/gig (only keywords are checked)
TG_JOB_CHANNELS=
RSS_FEEDS=
REDDIT_SUBS=
MASTODON_TAGS=
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# --- Paid / keyed sources. Each one is OFF until you set its key. Free sources never need any key ---
X_BEARER_TOKEN=
LEMMY_INSTANCES=
# Apify runs LinkedIn / Facebook / X scrapers for you (pay per result). One token, many actors.
APIFY_TOKEN=
# JSON list. "{keywords}" expands to a list of search phrases, "{query}" to one phrase. Check each actor's Input tab for its field names.
# need_intent=false for sources where every post is already a buyer. interval is in seconds (minimum 300, each run costs money).
APIFY_ACTORS=[{"name":"linkedin","actor":"lofomachines/linkedin-post-search-scraper","input":{"keywords":"{keywords}","maxResults":50},"interval":1800},{"name":"facebook","actor":"apify/facebook-posts-scraper","input":{"startUrls":[{"url":"https://www.facebook.com/SOME_PUBLIC_PAGE"}],"resultsLimit":30},"interval":3600,"need_intent":true},{"name":"x-apify","actor":"PUT_X_SEARCH_ACTOR_HERE","input":{"searchTerms":"{keywords}","maxItems":50},"interval":900}]
# Nairaland (free, on by default). Boards to watch; set INCLUDE_JOBS=true to also keep regular vacancies/internships
NAIRALAND_BOARDS=
NAIRALAND_INCLUDE_JOBS=false
# --- Tuning ---
MAX_AGE_HOURS=48
MIN_STORE_SCORE=35
